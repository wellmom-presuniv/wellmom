{
  "expo": {
    "name": "WellMom",
    "slug": "wellmom-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF5F9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arkapds.wellmommobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.arkapds.wellmommobile",
      "adaptiveIcon": {
        "backgroundColor": "#EC4899"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f999d03a-8cfc-41d2-a208-faa513b080f8"
      }
    }
  }
}
